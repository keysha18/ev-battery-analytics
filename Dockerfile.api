FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.3 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Dépendances d'abord (couche mise en cache tant que uv.lock ne change pas) : uniquement le groupe api,
# sans SciPy ni NumPy qui ne servent qu'au pipeline.
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-default-groups --group api --no-install-project

COPY src/__init__.py src/__init__.py
COPY src/api src/api

# Utilisateur non privilégié
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
