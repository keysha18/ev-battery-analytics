# Copier en .env (gitignoré) puis ajuster. Valeurs de développement local uniquement.
POSTGRES_DB=ev_battery
POSTGRES_USER=ev_admin
POSTGRES_PASSWORD=change_me_admin
# 5432 est souvent pris par un Postgres Windows natif
POSTGRES_PORT=5433

# Rôle en lecture seule sur le schéma marts, utilisé par l'API (étape 7)
API_RO_USER=api_ro
API_RO_PASSWORD=change_me_api
